# Template only. Copy to .env (keep this file) and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internconnect

# Long random string, at least 32 characters in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend origin(s). Comma-separate several (the first is used in email links)
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) API key used to send verification / reset emails
RESEND_API_KEY=re_your_api_key

# Sender address. Leave unset to use Resend's test sender, which only delivers
# to your own Resend account email. Use an address on a domain verified in Resend
# to email real users, e.g. InternConnect <no-reply@yourdomain.com>
EMAIL_FROM=
